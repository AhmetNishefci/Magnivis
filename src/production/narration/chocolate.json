      "file": "audio/chocolate/narration/cue-8.wav",
      "start": 24.533333333333335,
      "duration": 4.725,
      "transcript": "Tempering guides that rebuilding with controlled temperatures and mixing.",
      "sourceScriptSegmentId": "chocolate-crystal-choice.asset.same-recipe-different-structure.script.control",
      "beatIndex": 5,
      "samples": 113400,
      "sampleRate": 24000
    },
    {
