      "file": "audio/chocolate/narration/cue-6.wav",
      "start": 16.466666666666665,
      "duration": 3.825,
      "transcript": "But their arrangements, and the network they build, can differ.",
      "sourceScriptSegmentId": "chocolate-crystal-choice.asset.same-recipe-different-structure.script.arrange",
      "beatIndex": 3,
      "samples": 91800,
      "sampleRate": 24000
    },
    {
