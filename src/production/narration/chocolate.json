      "file": "audio/chocolate/narration/cue-7.wav",
      "start": 21.066666666666666,
      "duration": 3.2,
      "transcript": "The result can be softer chocolate with less snap.",
      "sourceScriptSegmentId": "chocolate-crystal-choice.asset.same-recipe-different-structure.script.result",
      "beatIndex": 4,
      "samples": 76800,
      "sampleRate": 24000
    },
    {
