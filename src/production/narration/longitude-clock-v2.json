      "start": 0.1,
      "duration": 2.65,
      "transcript": "How can a clock tell a ship where it is?"
    },
    {
      "id": "beat-2",
      "file": "audio/longitude-clock/v2/narration/beat-2.wav",
      "start": 3.066666666666667,
      "duration": 3.2,
      "transcript": "By keeping the time at a known reference point."
    },
    {
      "id": "beat-3",
      "file": "audio/longitude-clock/v2/narration/beat-3.wav",
      "start": 6.533333333333333,
      "duration": 5.8,
      "transcript": "Sailors use the Sun to find local time, corrected to match the clock’s timekeeping."
    },
    {
      "id": "beat-4",
      "file": "audio/longitude-clock/v2/narration/beat-4.wav",
      "start": 12.733333333333333,
      "duration": 2.45,
      "transcript": "Compare them at the same moment."
    },
    {
      "id": "beat-5",
      "file": "audio/longitude-clock/v2/narration/beat-5.wav",
      "start": 15.733333333333333,
      "duration": 5.425,
      "transcript": "Earth’s turning links that time difference to longitude: fifteen degrees per hour."
    },
    {
      "id": "beat-6",
      "file": "audio/longitude-clock/v2/narration/beat-6.wav",
      "start": 21.866666666666667,
      "duration": 3.975,
      "transcript": "Twelve at the reference. Two in the afternoon locally."
    },
    {
      "id": "beat-7",
      "file": "audio/longitude-clock/v2/narration/beat-7.wav",
      "start": 26.733333333333334,
      "duration": 3.1,
      "transcript": "Two hours ahead. Thirty degrees east."
    },
    {
      "id": "beat-8",
      "file": "audio/longitude-clock/v2/narration/beat-8.wav",
      "start": 31,
      "duration": 4.825,
      "transcript": "Harrison’s H4 helped demonstrate accurate timekeeping at sea."
    },
    {
      "id": "beat-9",
      "file": "audio/longitude-clock/v2/narration/beat-9.wav",
      "start": 36.06666666666667,
      "duration": 3.8,
      "transcript": "Other astronomical methods remained useful too."
    },
    {
      "id": "beat-10",
      "file": "audio/longitude-clock/v2/narration/beat-10.wav",
      "start": 40.166666666666664,
      "duration": 5.625,
      "transcript": "The clock carries time. Observation and calculation reveal longitude."
