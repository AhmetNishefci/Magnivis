  "cues": [
    {
      "id": "dice-cue-1",
      "transcript": "Pick a die. Higher number wins. Whatever you choose, I can pick one with better odds.",
      "file": "audio/dice/narration/cue-1.wav",
      "start": 0,
      "duration": 5.375,
      "beatIndex": 0,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.1",
      "samples": 129000,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-2",
      "transcript": "Every face has an equal chance in this puzzle, and neither roll affects the other.",
      "file": "audio/dice/narration/cue-2.wav",
      "start": 6.2,
      "duration": 5.125,
      "beatIndex": 1,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.2",
      "samples": 123000,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-3",
      "transcript": "Yellow always rolls three. Orange has four twos and two sixes. Yellow wins against four faces out of six: two-thirds.",
      "file": "audio/dice/narration/cue-3.wav",
      "start": 11.833333333333334,
      "duration": 8.475,
      "beatIndex": 2,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.3",
      "samples": 203400,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-4",
      "transcript": "But blue has four fours, so it has better odds against yellow.",
      "file": "audio/dice/narration/cue-4.wav",
      "start": 21.233333333333334,
      "duration": 4.2,
      "beatIndex": 3,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.4",
      "samples": 100800,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-5",
      "transcript": "Switch to blue? Green’s fives beat every blue face. Its ones still beat blue’s zeros.",
      "file": "audio/dice/narration/cue-5.wav",
      "start": 26.233333333333334,
      "duration": 5.9,
      "beatIndex": 4,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.5",
      "samples": 141600,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-6",
      "transcript": "Then orange counters green: its sixes beat everything, and its twos beat green’s ones.",
      "file": "audio/dice/narration/cue-6.wav",
      "start": 33.93333333333333,
      "duration": 5.975,
      "beatIndex": 5,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.6",
      "samples": 143400,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-7",
      "transcript": "And yellow still counters orange.",
      "file": "audio/dice/narration/cue-7.wav",
      "start": 41.733333333333334,
      "duration": 2.45,
      "beatIndex": 6,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.7",
      "samples": 58800,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-8",
      "transcript": "Every reply shown has those same two-thirds odds. That’s an advantage, not a guaranteed win.",
      "file": "audio/dice/narration/cue-8.wav",
      "start": 44.6,
      "duration": 6.525,
      "beatIndex": 7,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.8",
      "samples": 156600,
      "sampleRate": 24000
    },
    {
      "id": "dice-cue-9",
      "transcript": "The advantages form a circle. There’s no best die in this set—just a better matchup.",
      "file": "audio/dice/narration/cue-9.wav",
      "start": 51.733333333333334,
      "duration": 5.625,
      "beatIndex": 8,
      "sourceScriptSegmentId": "dice-no-best.asset.choose-second.script.9",
      "samples": 135000,
      "sampleRate": 24000
    }
