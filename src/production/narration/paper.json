      "beatIndex": 1,
      "sourceScriptSegmentId": "paper-half-shape.asset.hidden-geometry.script.2",
      "samples": 46800,
      "sampleRate": 24000
    },
    {
      "id": "paper-cue-5",
      "transcript": "Halve it, and you get a skinny rectangle.",
