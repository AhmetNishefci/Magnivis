      "beatIndex": 0,
      "sourceScriptSegmentId": "paper-half-shape.asset.hidden-geometry.script.1",
      "samples": 70800,
      "sampleRate": 24000
    },
    {
      "id": "paper-cue-4",
      "transcript": "A square cannot do that.",
