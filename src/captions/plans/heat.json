      "sourceNarrationCueId": "heat-cue-1",
      "startFrame": 0,
      "endFrame": 116,
      "lines": [
        "Why can a hotter pan make",
        "a drop of water last longer?"
      ],
      "bounds": {
        "x": 120,
        "y": 1370,
        "width": 760,
        "height": 220
      },
      "presentationIntent": "Preserve complete semantic sentence and qualifiers below enlarged interface."
    },
    {
      "id": "heat-caption-2",
      "sourceNarrationCueId": "heat-cue-2",
      "startFrame": 133,
      "endFrame": 282,
      "lines": [
        "On a hot metal surface,",
        "water can touch the metal",
        "and boil away quickly."
      ],
      "bounds": {
        "x": 120,
        "y": 1370,
        "width": 760,
        "height": 220
      },
      "presentationIntent": "Preserve complete semantic sentence and qualifiers below enlarged interface."
    },
    {
      "id": "heat-caption-3",
      "sourceNarrationCueId": "heat-cue-3",
      "startFrame": 290,
      "endFrame": 376,
      "lines": [
        "Heat it far enough,",
        "and something changes."
      ],
      "bounds": {
        "x": 120,
        "y": 1370,
        "width": 760,
        "height": 220
      },
      "presentationIntent": "Preserve complete semantic sentence and qualifiers below enlarged interface."
    },
    {
      "id": "heat-caption-4",
      "sourceNarrationCueId": "heat-cue-4",
      "startFrame": 385,
      "endFrame": 500,
      "lines": [
        "The bottom of the drop",
        "turns to vapor almost instantly."
      ],
      "bounds": {
        "x": 120,
        "y": 1370,
        "width": 760,
        "height": 220
      },
      "presentationIntent": "Preserve complete semantic sentence and qualifiers below enlarged interface."
    },
    {
      "id": "heat-caption-5",
      "sourceNarrationCueId": "heat-cue-5",
      "startFrame": 508,
      "endFrame": 644,
      "lines": [
        "That vapor forms a cushion,",
        "lifting the rest of the water",
        "off the metal."
      ],
      "bounds": {
        "x": 120,
        "y": 1370,
        "width": 760,
        "height": 220
      },
      "presentationIntent": "Preserve complete semantic sentence and qualifiers below enlarged interface."
