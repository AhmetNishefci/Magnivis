{
  "name": "magnivis",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted knowledge-media intelligence, production, and delivery system for Magnivis.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "tsx scripts/render.ts",
    "render:smoke": "tsx scripts/render-smoke.ts",
    "qa": "tsx scripts/qa.ts",
    "delivery": "tsx scripts/delivery.ts",
    "delivery:validate": "tsx scripts/validate-delivery.ts",
    "content:intelligence": "tsx scripts/content-intelligence.ts",
    "production:validate": "tsx scripts/validate-production.ts",
    "assets": "pnpm soundscape && pnpm narration earth-to-stars",
    "assets:ocean": "pnpm soundscape:ocean && pnpm narration ocean-depth",
    "assets:money": "pnpm soundscape:money && pnpm narration billion-dollars",
    "assets:light": "pnpm soundscape:light && pnpm narration speed-of-light",
    "assets:engineering": "pnpm soundscape:engineering && pnpm narration human-engineering",
    "assets:wood-frog": "pnpm soundscape:wood-frog && pnpm narration wood-frog",
    "captions:wood-frog": "tsx scripts/generate-captions.ts wood-frog",
    "soundscape": "node scripts/generate-audio.mjs",
    "soundscape:ocean": "node scripts/generate-ocean-audio.mjs",
    "soundscape:money": "node scripts/generate-money-audio.mjs",
    "soundscape:light": "node scripts/generate-light-audio.mjs",
    "soundscape:engineering": "node scripts/generate-engineering-audio.mjs",
    "soundscape:wood-frog": "node scripts/generate-wood-frog-audio.mjs",
    "narration": "node scripts/generate-narration.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests remotion.config.ts",
    "test": "vitest run",
    "validate": "pnpm typecheck && pnpm lint && pnpm test",
    "check": "pnpm validate && git diff --check"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@remotion/cli": "4.0.527",
    "@remotion/media": "4.0.527",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "openai": "7.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.527",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "10.0.1",
    "kokoro-js": "1.2.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
