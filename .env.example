# V1 requires no credentials or paid APIs.
# Future integrations must document variables here without real values.

# Required only for live Content Intelligence runs. Fixture tests and fixture trials need no key.
OPENAI_API_KEY=
# Optional global override for the versioned workflow defaults in src/ai/model-config.ts.
OPENAI_MODEL=

# Offline/local archive adapter; configure an independent durable location for real backup
# MAGNIVIS_ARTIFACT_LOCAL_ROOT=/absolute/path/to/archive
