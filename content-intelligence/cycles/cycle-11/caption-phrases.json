[[["To defend himself,"],["this painter had to prove"],["his masterpiece was a fake."]],[["In 1945,"],["Han van Meegeren"],["was arrested on suspicion"],["of collaboration."],["A supposed Vermeer"],["had reached Hermann Göring,"],["a leading Nazi,"],["through an art dealer."]],[["His defense was that"],["he had painted it himself."],["But some experts resisted"],["believing that their"],["celebrated Vermeers"],["were forgeries."]],[["He had exploited a gap"],["in Vermeer’s known"],["early work."],["Religious paintings filled"],["what experts expected"],["to find."],["A prominent scholar"],["endorsed one;"],["a museum bought it."]],[["He used old canvases,"],["then heated modern"],["resin-based paint"],["until it hardened."],["Cracking that surface"],["made new paint"],["look centuries old."]],[["But court-appointed"],["examiners tested"],["the materials."],["They found evidence"],["of modern synthetic resin,"],["matching materials"],["from his studio."]],[["X-rays revealed"],["another problem:"],["separate crack patterns"],["in the old layers underneath"],["and the newer painting"],["above."]],[["The evidence supported"],["his confession."],["An old canvas"],["did not make the painting"],["an old master."]],[["The collaboration case"],["fell away."],["The fraud did not."],["In 1947,"],["he was convicted"],["of fraud and forgery,"],["and sentenced"],["to one year."]],[["He had not sold a Vermeer."],["He had sold the belief"],["that it was one."]]]
