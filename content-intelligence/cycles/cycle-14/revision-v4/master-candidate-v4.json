  "narration": [
    {
      "id": "dice-cue-1",
      "transcript": "Pick a die. Higher number wins. Whatever you choose, I can pick one with better odds.",
      "start": 0,
      "duration": 5.375,
      "media": {
        "id": "media.0dedf2864475485b28ba4c6629aebbe2f439a5f576ba0a7b5f5019ca3c9bc4b0",
        "sha256": "0dedf2864475485b28ba4c6629aebbe2f439a5f576ba0a7b5f5019ca3c9bc4b0"
      }
    },
    {
      "id": "dice-cue-2",
      "transcript": "Every face has an equal chance in this puzzle, and neither roll affects the other.",
      "start": 6.2,
      "duration": 5.125,
      "media": {
        "id": "media.ea32fc267b34d3f7d26cff0501ec85b321ab9cdd4ac54d3cf0b031618ddc02c5",
        "sha256": "ea32fc267b34d3f7d26cff0501ec85b321ab9cdd4ac54d3cf0b031618ddc02c5"
      }
    },
    {
      "id": "dice-cue-3",
      "transcript": "Yellow always rolls three. Orange has four twos and two sixes. Yellow wins against four faces out of six: two-thirds.",
      "start": 11.833333333333334,
      "duration": 8.475,
      "media": {
        "id": "media.a0b70ffbf94aa2ce35d34cdffaecb3d57688cf4f628d79ada124eb2cc46af6ba",
        "sha256": "a0b70ffbf94aa2ce35d34cdffaecb3d57688cf4f628d79ada124eb2cc46af6ba"
      }
    },
    {
      "id": "dice-cue-4",
      "transcript": "But blue has four fours, so it has better odds against yellow.",
      "start": 21.233333333333334,
      "duration": 4.2,
      "media": {
        "id": "media.6b4fbddbc545cfb554f5bd8f51ea84c83a6956836cef727fd88efaafc1390dcb",
        "sha256": "6b4fbddbc545cfb554f5bd8f51ea84c83a6956836cef727fd88efaafc1390dcb"
      }
    },
    {
      "id": "dice-cue-5",
      "transcript": "Switch to blue? Green’s fives beat every blue face. Its ones still beat blue’s zeros.",
      "start": 26.233333333333334,
      "duration": 5.9,
      "media": {
        "id": "media.928c776ee5c6cc75f7fa2a94bc6bff46b9dcb17114d4c4e5ac87fceb6c6b3f82",
        "sha256": "928c776ee5c6cc75f7fa2a94bc6bff46b9dcb17114d4c4e5ac87fceb6c6b3f82"
      }
    },
    {
      "id": "dice-cue-6",
      "transcript": "Then orange counters green: its sixes beat everything, and its twos beat green’s ones.",
      "start": 34.93333333333333,
      "duration": 5.975,
      "media": {
        "id": "media.56493aec1ba06f515520cc260b32bb2cf85035f522c79d89063b4a573aeb26f9",
        "sha256": "56493aec1ba06f515520cc260b32bb2cf85035f522c79d89063b4a573aeb26f9"
      }
    },
    {
      "id": "dice-cue-7",
      "transcript": "And yellow still counters orange.",
      "start": 43.733333333333334,
      "duration": 2.45,
      "media": {
        "id": "media.b8e0ef23419b17b2a24a676c80291765d48f0a3fe8d2580d341a46add6d05708",
        "sha256": "b8e0ef23419b17b2a24a676c80291765d48f0a3fe8d2580d341a46add6d05708"
      }
    },
    {
      "id": "dice-cue-8",
      "transcript": "Every reply shown has those same two-thirds odds. That’s an advantage, not a guaranteed win.",
      "start": 46.6,
      "duration": 6.525,
      "media": {
        "id": "media.31925d6636513a76c1a7a3094ff0596ac4f2339fd46125b9e7b6b1e2087c5ff3",
        "sha256": "31925d6636513a76c1a7a3094ff0596ac4f2339fd46125b9e7b6b1e2087c5ff3"
      }
    },
    {
      "id": "dice-cue-9",
      "transcript": "The advantages form a circle. There’s no best die in this set—just a better matchup.",
      "start": 53.733333333333334,
      "duration": 5.625,
      "media": {
        "id": "media.b03f7ca035774509197ce7dc560f10f48534c60a020a017bc1b6d331086edb4b",
