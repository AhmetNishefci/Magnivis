    "language": "en",
    "segments": [
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.1",
        "type": "factual",
        "text": "Cut A4 paper in half. Turn it. It’s almost the same shape, only smaller.",
        "claimIds": [
          "paper-half-shape.claim.similarity",
          "paper-half-shape.claim.rounded"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.2",
        "type": "factual",
        "text": "A square cannot do that. Halve it, and you get a skinny rectangle.",
        "claimIds": [
          "paper-half-shape.claim.square"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.3",
        "type": "factual",
        "text": "A-series paper is built around a special ratio: one to the square root of two.",
        "claimIds": [
          "paper-half-shape.claim.ratio"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.4",
        "type": "factual",
        "text": "Halve the long side, then rotate the piece. That ratio comes back.",
        "claimIds": [
          "paper-half-shape.claim.similarity",
          "paper-half-shape.claim.ratio"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.5",
        "type": "factual",
        "text": "In the ideal system, an A3 design shrinks to A4 without stretching.",
        "claimIds": [
          "paper-half-shape.claim.scaling"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.6",
        "type": "factual",
        "text": "Each length shrinks to about seventy-one percent. The area halves.",
        "claimIds": [
          "paper-half-shape.claim.length-area"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.7",
        "type": "factual",
        "text": "Real paper sizes are rounded to whole millimetres. The perfect rule lives in the geometry.",
        "claimIds": [
          "paper-half-shape.claim.rounded",
          "paper-half-shape.claim.ratio"
        ]
      },
      {
        "id": "paper-half-shape.asset.hidden-geometry.script.8",
        "type": "factual",
        "text": "Half the paper. Same proportions.",
        "claimIds": [
          "paper-half-shape.claim.similarity"
        ]
      }
    ]
  },
