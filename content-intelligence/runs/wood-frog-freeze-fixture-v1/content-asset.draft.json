      },
      {
        "claimIds": [
          "wood-frog-freeze-tolerance.claim.heartbeat-breathing-stop",
          "wood-frog-freeze-tolerance.claim.ice-redistribution"
        ],
        "id": "wood-frog-freeze-tolerance.asset.how-freezing-works.script.payoff",
        "text": "When spring warms the frog, its heart and breathing return. It did not defeat freezing—it controlled where the damage could happen.",
        "type": "factual"
      }
